<div id="kanban-board-root" class="hd-kanban-board" aria-busy={if(@busy != nil, do: "true", else: "false")}>
  <HolodeckWeb.Components.PageHeader kicker="Nested components · targeted actions" title="Shared Kanban" description="One public board. Anyone can edit. Open another browser and move together.">
    <button id="kanban-sync" type="button" $click="sync" class="hd-btn">Sync board</button>
    <button id="kanban-reset" type="button" $click="confirm_reset" disabled={@busy != nil} class="hd-btn">Reset demo</button>
  </HolodeckWeb.Components.PageHeader>

  {%if @reset_confirmation != nil}
    <div id="kanban-reset-confirmation" class="rounded-lg border border-warning/30 bg-warning/5 p-4 mb-4 text-sm">
      <p>Reset public revision {@reset_confirmation}? This replaces everyone’s cards. Resets have a global 60-second cooldown.</p>
      <div class="flex gap-2 mt-3">
        <button id="kanban-reset-confirm" type="button" $click="reset_board" disabled={@busy != nil} class="hd-btn">Yes, reset everyone’s board</button>
        <button id="kanban-reset-cancel" type="button" $click="cancel_reset" class="hd-btn">Cancel</button>
      </div>
    </div>
  {/if}

  <form id="kanban-add" $submit="add_card" class="flex flex-wrap gap-2 mb-2">
    <label for="kanban-title" class="sr-only">New card title</label>
    <input id="kanban-title" name="title" value={@draft_title} $change="update_draft" maxlength="120" required disabled={@busy != nil} placeholder="What’s next? Add a card to To do…" class="hd-input flex-1 w-auto min-w-48" />
    <button id="kanban-add-button" type="submit" disabled={@busy != nil or length(@confirmed.cards) >= 30} class="hd-btn hd-btn-primary">Add card</button>
  </form>
  <p id="kanban-meta" class="text-xs font-mono text-base-content/40 mb-1">Revision {@confirmed.revision} · {length(@confirmed.cards)}/30 cards · Moves append to a column</p>
  <div id="kanban-status" role="status" aria-live="polite" aria-atomic="true" class="min-h-8 text-xs text-base-content/60 mb-3">
    {%if @error != ""}{@error}{%else}{@status}{/if}
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-start">
    {%for {column, label} <- [{"todo", "To do"}, {"doing", "In progress"}, {"done", "Done"}]}
      <HolodeckWeb.Components.Kanban.Column cid={"kanban-column-" <> column} column={column} label={label} cards={Enum.filter(display_cards(@confirmed, @pending), &(&1.column == column))} disabled={@busy != nil} />
    {/for}
  </div>
</div>
