<div class="min-h-screen bg-base-100 text-base-content font-sans text-sm relative overflow-x-hidden">

  <div class="hd-grain fixed inset-0 pointer-events-none z-0 opacity-[0.025]"></div>
  <div class="hd-glow fixed top-[-30%] left-1/2 -translate-x-1/2 w-[70vw] h-[50vh] pointer-events-none z-0"></div>

  <div class="relative z-[1] max-w-[1180px] mx-auto px-6 pb-12">

    <nav class="flex items-center py-[18px] mb-6 border-b border-white/[0.08]">
      <div class="flex items-center gap-2.5 text-[15px] font-semibold tracking-[-0.01em]">
        <Hologram.UI.Link to={HolodeckWeb.HomePage} class="flex items-center gap-2.5 no-underline text-base-content">
          <div class="hd-logo-icon w-7 h-7 rounded-[7px] flex items-center justify-center text-sm font-bold text-white shrink-0">H</div>
          Holodeck
        </Hologram.UI.Link>
        <span class="text-base-content/50 mx-px">/</span>
        <span class="text-base-content/75 font-normal">Vote</span>
      </div>
    </nav>

    <div class="max-w-[480px] mx-auto">

      {%if @poll}
        <div class="text-base-content/35 text-[11px] uppercase tracking-[1px] mb-2.5 font-mono">Cast Your Vote</div>

        <div class="bg-base-300 border border-white/20 rounded-lg px-5 py-5 flex flex-col gap-5">

          <div class="text-[15px] font-semibold text-base-content tracking-[-0.01em]">{@poll.question}</div>

          <hr class="border-0 border-t border-white/[0.08]" />

          <div class="flex flex-col gap-2.5">
            {%for {n, label} <- [{1, @poll.answer_1}, {2, @poll.answer_2}, {3, @poll.answer_3}, {4, @poll.answer_4}]}
              <button
                $click={:vote, answer_number: n}
                class="flex items-center gap-3 text-left bg-transparent border border-white/[0.12] hover:border-primary/60 hover:bg-white/[0.03] rounded-md px-4 py-3 cursor-pointer transition-colors"
              >
                <span class="text-base-content/35 text-[11px] font-mono shrink-0 w-[18px]">{n}</span>
                <span class="text-base-content text-[13px] font-mono">{label}</span>
              </button>
            {/for}
          </div>

        </div>
      {%else}
        <h1 class="text-[15px] font-semibold mb-3">Poll not found</h1>
        <Hologram.UI.Link to={HolodeckWeb.Poll.PollPage} class="text-primary hover:underline">Create a poll</Hologram.UI.Link>
      {/if}

    </div>
  </div>
</div>
