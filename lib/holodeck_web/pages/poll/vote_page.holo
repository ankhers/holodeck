<HolodeckWeb.Components.AppShell breadcrumbs={@breadcrumbs}>

  <div class="max-w-[480px] min-w-0 mx-auto">

    {%if @poll}
      <HolodeckWeb.Components.PageHeader kicker="Commands · realtime broadcasts" title="Cast your vote" description="Pick one answer. The results page updates for everyone the moment you vote." />

      <div class="bg-base-300 border border-white/20 rounded-lg px-5 py-5 flex flex-col gap-5">

        <div class="text-[15px] font-semibold text-base-content tracking-[-0.01em] break-words">{@poll.question}</div>

        <hr class="border-0 border-t border-white/[0.08]" />

        {%if @voted?}
          <p id="already-voted" class="text-[13px] text-base-content/75">
            You've already voted on this poll.
            <Hologram.UI.Link to={HolodeckWeb.Poll.ResultPage, poll_id: @poll.id} class="text-primary hover:underline">View results</Hologram.UI.Link>
          </p>
        {/if}

        <div class="flex flex-col gap-2.5">
          {%for {n, label} <- [{1, @poll.answer_1}, {2, @poll.answer_2}, {3, @poll.answer_3}, {4, @poll.answer_4}]}
            <button
              id="vote-option-{n}"
              disabled={@voted?}
              $click={:vote, answer_number: n}
              class="flex items-center gap-3 text-left bg-transparent border border-white/[0.12] hover:border-primary/60 hover:bg-white/[0.03] rounded-md px-4 py-3 cursor-pointer transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
            >
              <span class="text-base-content/35 text-[11px] font-mono shrink-0 w-[18px]">{n}</span>
              <span class="text-base-content text-[13px] font-mono min-w-0 break-words">{label}</span>
            </button>
          {/for}
        </div>

      </div>
    {%else}
      <HolodeckWeb.Components.PageHeader title="Poll not found" description="This link doesn't match a poll. It may have been mistyped." />
      <Hologram.UI.Link to={HolodeckWeb.Poll.PollPage} class="hd-btn">Create a poll</Hologram.UI.Link>
    {/if}

  </div>
</HolodeckWeb.Components.AppShell>
