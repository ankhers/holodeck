<div class="min-h-screen bg-base-100 text-base-content font-sans text-sm relative overflow-x-hidden">

  <div class="hd-grain fixed inset-0 pointer-events-none z-0 opacity-[0.025]"></div>
  <div class="hd-glow fixed top-[-30%] left-1/2 -translate-x-1/2 w-[70vw] h-[50vh] pointer-events-none z-0"></div>

  <div class="relative z-[1] max-w-[1180px] mx-auto px-6 pb-12">

    <nav class="flex items-center py-[18px] mb-6 border-b border-white/[0.08]">
      <div class="flex items-center gap-2.5 text-[15px] font-semibold tracking-[-0.01em]">
        <Hologram.UI.Link to={HolodeckWeb.HomePage} class="flex items-center gap-2.5 no-underline text-base-content">
          <div class="hd-logo-icon w-7 h-7 rounded-[7px] flex items-center justify-center text-sm font-bold text-white shrink-0">H</div>
          Holodeck
        </Hologram.UI.Link>
        <span class="text-base-content/50 mx-px">/</span>
        <span class="text-base-content/75 font-normal">Results</span>
      </div>
    </nav>

    <div class="max-w-[560px] mx-auto">

      {%if @poll}
      <div class="text-base-content/35 text-[11px] uppercase tracking-[1px] mb-2.5 font-mono">Poll Results</div>

      <div class="bg-base-300 border border-white/20 rounded-lg px-5 py-5 flex flex-col gap-5">

        <div class="text-[15px] font-semibold text-base-content tracking-[-0.01em]">{@poll.question}</div>

        <!--
          chart.js integration point.
          The canvas below carries the poll data on data-* attributes so a chart.js
          init script can read it from el.dataset with no inline scripting:
            labels -> data-label-1 .. data-label-4
            values -> data-count-1 .. data-count-4 (parse with Number)
          Wire it up in an external module or a Hologram JS interop action.
        -->
        <div class="relative h-[280px]">
          <canvas id="poll-results-chart"></canvas>
        </div>

        <hr class="border-0 border-t border-white/[0.08]" />

        <!-- No-JS fallback / accessible summary: renders meaningfully before chart.js loads -->
        <div class="flex flex-col gap-3">
          {%for {n, label} <- [{1, @poll.answer_1}, {2, @poll.answer_2}, {3, @poll.answer_3}, {4, @poll.answer_4}]}
            <div class="flex items-center gap-2.5">
              <span class="text-base-content/75 text-[12px] font-mono w-[120px] shrink-0 truncate">{label}</span>
              <div class="flex-1 h-[7px] rounded-full bg-white/[0.06] overflow-hidden">
                <div style="height: 100%; border-radius: 99px; background: var(--color-primary, #6366f1); width: {Map.get(@frequencies, n, 0) / max(length(@answers), 1) * 100}%;"></div>
              </div>
              <span class="text-base-content/50 text-[11px] font-mono w-[34px] text-right">{Map.get(@frequencies, n, 0)}</span>
            </div>
          {/for}
        </div>

        <div class="text-base-content/35 text-[11px] uppercase tracking-[1px] font-mono text-right">{length(@answers)} votes</div>

      </div>

      <p class="text-base-content/50 text-[12px] text-center mt-4">
        Haven't voted yet? Head to the
        <Hologram.UI.Link to={HolodeckWeb.Poll.VotePage, poll_id: @poll.id} class="text-primary no-underline hover:underline">vote page</Hologram.UI.Link>
        to cast your vote.
      </p>
      {%else}
        <h1 class="text-[15px] font-semibold mb-3">Poll not found</h1>
        <Hologram.UI.Link to={HolodeckWeb.Poll.PollPage} class="text-primary hover:underline">Create a poll</Hologram.UI.Link>
      {/if}

    </div>
  </div>
</div>
