<HolodeckWeb.Components.AppShell breadcrumbs={@breadcrumbs}>
  <div class="max-w-[560px] min-w-0 mx-auto">
    {%if @poll}
      <HolodeckWeb.Components.PageHeader kicker="JS interop · Chart.js" title="Poll results" description="Votes stream in live and Chart.js redraws in place." />
      <div class="bg-base-300 border border-white/20 rounded-lg p-4 sm:p-5 flex flex-col gap-5 min-w-0">
        <h2 class="text-[15px] font-semibold text-base-content tracking-[-0.01em] break-words">{@poll.question}</h2>
        <div class="relative h-[240px] sm:h-[280px] min-w-0">
          <canvas id="poll-results-chart" aria-hidden="true"></canvas>
        </div>
        <section aria-label="Vote summary" class="border-t border-white/10 pt-3">
          <ul id="poll-summary" class="space-y-2">
            {%for {n, label} <- [{1, @poll.answer_1}, {2, @poll.answer_2}, {3, @poll.answer_3}, {4, @poll.answer_4}]}
              <li class="flex items-start justify-between gap-3 text-[12px] font-mono text-base-content/60">
                <span class="min-w-0 break-words">{label}</span>
                <span class="shrink-0">{Map.get(@frequencies, n, 0)} · {round(Map.get(@frequencies, n, 0) / max(length(@answers), 1) * 100)}%</span>
              </li>
            {/for}
          </ul>
          <p id="poll-vote-total" data-vote-count={length(@answers)} class="text-base-content/50 text-[11px] uppercase tracking-[1px] font-mono text-right mt-3">{length(@answers)} {if length(@answers) == 1 do "vote" else "votes" end}</p>
        </section>
        <div class="border-t border-white/10 pt-4">
          <label for="poll-vote-url" class="block text-[11px] uppercase tracking-[0.08em] font-mono text-base-content/50 mb-1.5">Share this poll</label>
          <div class="flex flex-col sm:flex-row gap-2">
            <input id="poll-vote-url" type="text" readonly value={@vote_url} class="hd-input" />
            <button id="copy-poll-link" type="button" $click="copy_link" class="hd-btn shrink-0">Copy link</button>
          </div>
        </div>
      </div>
      {%if @voted?}
        <p id="poll-voted" class="text-primary text-[12px] text-center mt-4">You voted. Thanks for taking part!</p>
      {%else}
        <p class="text-base-content/50 text-[12px] text-center mt-4">
          Haven't voted yet? Head to the
          <Hologram.UI.Link to={HolodeckWeb.Poll.VotePage, poll_id: @poll.id} class="text-primary no-underline hover:underline">vote page</Hologram.UI.Link>
          to cast your vote.
        </p>
      {/if}
    {%else}
      <HolodeckWeb.Components.PageHeader title="Poll not found" description="This link doesn't match a poll. It may have been mistyped." />
      <Hologram.UI.Link to={HolodeckWeb.Poll.PollPage} class="hd-btn">Create a poll</Hologram.UI.Link>
    {/if}
  </div>
</HolodeckWeb.Components.AppShell>
