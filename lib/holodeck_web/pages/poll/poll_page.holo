<HolodeckWeb.Components.AppShell breadcrumbs={[{"Polls", nil}]}>

    <div class="max-w-[480px] mx-auto">

      <div class="text-base-content/35 text-[11px] uppercase tracking-[1px] mb-2.5 font-mono">Create Poll</div>

      <form $submit="create_poll" class="bg-base-300 border border-white/20 rounded-lg px-4 py-4 flex flex-col gap-3">

        <div class="flex items-center gap-2.5">
          <span class="text-base-content/35 text-[11px] tracking-[1px] uppercase font-mono shrink-0 w-[68px]">Question</span>
          <input type="text" name="question" class="flex-1 bg-transparent border-none outline-none text-base-content font-mono text-[13px]" />
        </div>

        <hr class="border-0 border-t border-white/[0.08]" />

        <div class="flex items-center gap-2.5">
          <span class="text-base-content/35 text-[11px] tracking-[1px] uppercase font-mono shrink-0 w-[68px]">Option 1</span>
          <input type="text" name="answer_1" autocomplete="off" class="flex-1 bg-transparent border-none outline-none text-base-content font-mono text-[13px]" />
        </div>

        <div class="flex items-center gap-2.5">
          <span class="text-base-content/35 text-[11px] tracking-[1px] uppercase font-mono shrink-0 w-[68px]">Option 2</span>
          <input type="text" name="answer_2" autocomplete="off" class="flex-1 bg-transparent border-none outline-none text-base-content font-mono text-[13px]" />
        </div>

        <div class="flex items-center gap-2.5">
          <span class="text-base-content/35 text-[11px] tracking-[1px] uppercase font-mono shrink-0 w-[68px]">Option 3</span>
          <input type="text" name="answer_3" autocomplete="off" class="flex-1 bg-transparent border-none outline-none text-base-content font-mono text-[13px]" />
        </div>

        <div class="flex items-center gap-2.5">
          <span class="text-base-content/35 text-[11px] tracking-[1px] uppercase font-mono shrink-0 w-[68px]">Option 4</span>
          <input type="text" name="answer_4" autocomplete="off" class="flex-1 bg-transparent border-none outline-none text-base-content font-mono text-[13px]" />
        </div>

        <div class="flex justify-end pt-1">
          <button type="submit" class="bg-primary text-primary-content border-none rounded px-3 py-1 font-semibold cursor-pointer font-mono">Create</button>
        </div>

      </form>

    </div>
</HolodeckWeb.Components.AppShell>
