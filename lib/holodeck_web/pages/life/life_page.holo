<HolodeckWeb.Components.AppShell breadcrumbs={[{"Game of Life", nil}]}>
  <HolodeckWeb.Components.PageHeader kicker="Client-side Elixir · delayed actions" title="Game of Life" description="Simple rules. Emergent worlds. Entirely Elixir.">
    <span class="border border-primary/25 bg-primary/5 rounded-full px-3 py-1.5 text-primary text-[11px] font-mono">Elixir running in your browser</span>
  </HolodeckWeb.Components.PageHeader>

  <div class="hd-life-layout">
    <aside class="flex flex-col gap-3 min-w-0">
      <section class="hd-life-panel p-5">
        <h2 class="hd-life-label mb-4">Take control</h2>
        <div class="flex flex-wrap items-center gap-2 mb-5">
          <button id="life-play" type="button" class="hd-btn hd-btn-primary min-w-[76px]" $click={if(@running, do: :pause, else: :play)}>{if(@running, do: "Pause", else: "Play")}</button>
          <button id="life-step" type="button" disabled={@running} class="hd-btn py-2 text-[13px]" $click="step">Step</button>
        </div>
        <label for="life-speed" class="hd-life-label block mb-2">Tick interval</label>
        <select id="life-speed" class="hd-input mb-5 cursor-pointer" $change="speed">
          {%for delay <- speeds()}
            <option value={delay} selected={delay == @delay_ms}>{delay} ms</option>
          {/for}
        </select>
        <div class="flex flex-wrap gap-2">
          <button id="life-clear" type="button" class="hd-btn" $click="clear">Clear</button>
          <button id="life-randomise" type="button" class="hd-btn" $click="randomise">Randomise</button>
        </div>
        <h2 class="hd-life-label mt-6 mb-3">Seed a pattern</h2>
        <div class="flex flex-wrap gap-2">
          {%for name <- Life.presets()}
            <button id={"life-preset-#{name}"} type="button" class="hd-btn" $click={:preset, name: name}>{String.capitalize(Atom.to_string(name))}</button>
          {/for}
        </div>
        <p class="mt-4 text-xs leading-relaxed text-base-content/50">Click any cell to shape the world, even while it’s playing. Seeds reset the generation and pause the simulation, and so does extinction.</p>
      </section>
      <section class="hd-life-panel p-5">
        <h2 class="hd-life-label mb-3">The rules</h2>
        <p class="text-sm leading-relaxed text-base-content/75">A live cell survives with 2 or 3 neighbours. A dead cell is born with exactly 3. The edges wrap: anything leaving one side comes back on the other.</p>
        <div class="mt-5 pt-4 border-t border-white/[0.08]">
          <p class="text-primary text-xs font-mono mb-2">Simulation server commands: 0</p>
          <p class="text-xs leading-relaxed text-base-content/50">After loading, every control and generation runs locally.</p>
        </div>
      </section>
    </aside>

    <section class="hd-life-panel min-w-0" aria-label="Simulation">
      <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-4 border-b border-white/[0.08] font-mono text-xs">
        <span class="text-base-content/50">{Life.size()} × {Life.size()} <span class="text-base-content/25">/</span> wrapping world</span>
        <span id="life-status" class={if(status(@running, @generation, @population) == "Extinct", do: "text-warning", else: "text-primary")}>{status(@running, @generation, @population)}</span>
      </div>
      <div id="life-board-scroll" class="hd-life-board-scroll" role="region" aria-label="Scrollable Game of Life board">
        <div id="life-board" class="hd-life-board" style={"--hd-life-size: #{Life.size()}"}>
          {%for {cell, id} <- Enum.with_index(Tuple.to_list(@cells))}
            <button type="button" id={"life-cell-#{id}"} class={if(cell == 1, do: "hd-life-cell hd-life-cell-live", else: "hd-life-cell")} aria-pressed={if(cell == 1, do: "true", else: "false")} aria-label={"Cell #{rem(id, Life.size()) + 1}, #{div(id, Life.size()) + 1}"} $click={:toggle, id: id}></button>
          {/for}
        </div>
      </div>
      <div class="flex flex-wrap gap-6 px-5 py-4 border-t border-white/[0.08] font-mono text-xs text-base-content/50">
        <span>Generation <strong id="life-generation" class="text-base-content ml-2">{@generation}</strong></span>
        <span>Population <strong id="life-population" class="text-primary ml-2">{@population}</strong></span>
      </div>
    </section>
  </div>
</HolodeckWeb.Components.AppShell>
