<HolodeckWeb.Components.AppShell breadcrumbs={[{"Chat", nil}]}>
  <div class="w-full max-w-[480px] min-w-0 mx-auto">
    <HolodeckWeb.Components.PageHeader kicker="Commands · broadcasts · sessions" title="Chat" description="Pick a name, open a room, and talk to everyone in it in real time." />

    <form id="username-form" $submit="save_username" class="bg-base-300 border border-white/15 rounded-lg p-4 mb-6">
      <label for="chat-username" class="block text-[11px] uppercase tracking-[0.08em] font-mono text-base-content/50 mb-1.5">Username</label>
      <div class="flex items-center gap-2.5">
        <div class="flex-1 min-w-0">
          <input id="chat-username" type="text" name="username" value={@username} placeholder="e.g. Alex" autocomplete="nickname" class="hd-input" />
        </div>
        <button id="save-username" type="submit" class="hd-btn hd-btn-primary">Save</button>
      </div>
      {%if @username != ""}
        <p id="current-username" class="text-[12px] text-base-content/50 font-mono mt-3 break-words">Chatting as <strong class="text-base-content/90">{@username}</strong></p>
      {/if}
    </form>

    <h2 class="text-base-content/50 text-[11px] uppercase tracking-[0.08em] mb-2.5 font-mono">Rooms</h2>
    <form id="new-room-form" $submit="create_room" class="bg-base-300 border border-white/15 rounded-lg p-4 mb-4">
      <label for="chat-room-name" class="block text-[11px] uppercase tracking-[0.08em] font-mono text-base-content/50 mb-1.5">New room</label>
      <div class="flex items-center gap-2.5">
        <div class="flex-1 min-w-0">
          <input id="chat-room-name" type="text" name="room_name" maxlength="40" aria-describedby="chat-room-name-hint" placeholder="e.g. general" class="hd-input" />
        </div>
        <button id="create-room" type="submit" class="hd-btn hd-btn-primary">Create</button>
      </div>
      <p id="chat-room-name-hint" class="text-[12px] text-base-content/50 font-mono mt-3">3–40 characters: letters, numbers, dashes and underscores.</p>
    </form>

    <div id="room-list">
      {%for room <- @rooms}
        <div class="bg-base-300 border border-white/15 rounded-md px-3.5 py-2.5 flex justify-between items-center gap-3 mb-1.5">
          <span class="text-secondary font-mono min-w-0 break-all"># {room.name}</span>
          <Hologram.UI.Link to={HolodeckWeb.Chat.RoomPage, room_name: room.name} class="hd-btn">Join</Hologram.UI.Link>
        </div>
      {/for}
    </div>
  </div>
</HolodeckWeb.Components.AppShell>
