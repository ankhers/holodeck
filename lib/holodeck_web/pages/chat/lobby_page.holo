<HolodeckWeb.Components.AppShell breadcrumbs={[{"Chat", nil}]}>
  <div class="w-full max-w-[480px] min-w-0 mx-auto">
    <form id="username-form" $submit="save_username" class="bg-base-300 border border-white/15 rounded-lg p-4 mb-6">
      <label for="chat-username" class="block text-[11px] uppercase tracking-[0.08em] font-mono text-base-content/50 mb-1.5">Username</label>
      <div class="flex items-center gap-2.5">
        <div class="flex-1 min-w-0">
          <input id="chat-username" type="text" name="username" value={@username} placeholder="e.g. Alex" autocomplete="nickname" class="w-full bg-base-100 border border-white/15 rounded-md px-3 py-2 text-[13px] font-mono text-base-content placeholder:text-base-content/30 outline-none transition-colors focus:border-primary/60 focus:ring-2 focus:ring-primary/20" />
        </div>
        <button id="save-username" type="submit" class="bg-primary text-primary-content rounded-md px-3.5 py-2 text-[13px] font-semibold font-mono cursor-pointer transition hover:brightness-110 active:translate-y-px disabled:opacity-50 disabled:cursor-not-allowed">Save</button>
      </div>
      {%if @username != ""}
        <p id="current-username" class="text-[12px] text-base-content/50 font-mono mt-3 break-words">Chatting as <strong class="text-base-content/90">{@username}</strong></p>
      {/if}
    </form>

    <h1 class="text-base-content/50 text-[11px] uppercase tracking-[0.08em] mb-2.5 font-mono">Rooms</h1>
    <form id="new-room-form" $submit="create_room" class="bg-base-300 border border-white/15 rounded-lg p-4 mb-4">
      <label for="chat-room-name" class="block text-[11px] uppercase tracking-[0.08em] font-mono text-base-content/50 mb-1.5">New room</label>
      <div class="flex items-center gap-2.5">
        <div class="flex-1 min-w-0">
          <input id="chat-room-name" type="text" name="room_name" maxlength="40" aria-describedby="chat-room-name-hint" placeholder="e.g. general" class="w-full bg-base-100 border border-white/15 rounded-md px-3 py-2 text-[13px] font-mono text-base-content placeholder:text-base-content/30 outline-none transition-colors focus:border-primary/60 focus:ring-2 focus:ring-primary/20" />
        </div>
        <button id="create-room" type="submit" class="bg-primary text-primary-content rounded-md px-3.5 py-2 text-[13px] font-semibold font-mono cursor-pointer transition hover:brightness-110 active:translate-y-px disabled:opacity-50 disabled:cursor-not-allowed">Create</button>
      </div>
      <p id="chat-room-name-hint" class="text-[12px] text-base-content/50 font-mono mt-3">3–40 characters: letters, numbers, dashes and underscores.</p>
    </form>

    <div id="room-list">
      {%for room <- @rooms}
        <div class="bg-base-300 border border-white/15 rounded-md px-3.5 py-2.5 flex justify-between items-center gap-3 mb-1.5">
          <span class="text-secondary font-mono min-w-0 break-all"># {room.name}</span>
          <Hologram.UI.Link to={HolodeckWeb.Chat.RoomPage, room_name: room.name} class="border border-white/15 text-base-content/75 rounded-md px-3 py-1.5 text-[12px] font-mono cursor-pointer transition-colors hover:border-primary/50 hover:text-base-content">Join</Hologram.UI.Link>
        </div>
      {/for}
    </div>
  </div>
</HolodeckWeb.Components.AppShell>
