<HolodeckWeb.Components.AppShell breadcrumbs={[{"Chat", nil}]}>

  <div class="max-w-[480px] mx-auto">

    <form $submit="save_username" class="bg-base-300 border border-white/20 rounded-lg px-4 py-3 mb-6 flex items-center gap-2.5">
      <span class="text-base-content/35 text-[11px] tracking-[1px] uppercase font-mono">Username</span>
      <input type="text" name="username" value={@username} class="flex-1 bg-transparent border-none outline-none text-base-content font-mono text-[13px]" />
      <button type="submit" class="bg-primary text-primary-content border-none rounded px-3 py-1 font-semibold cursor-pointer font-mono">Save</button>
    </form>

    <div class="text-base-content/35 text-[11px] uppercase tracking-[1px] mb-2.5 font-mono">Rooms</div>

    <form $submit="create_room" class="bg-base-300 border border-white/20 rounded-lg px-4 py-3 mb-4 flex items-center gap-2.5">
      <span class="text-base-content/35 text-[11px] tracking-[1px] uppercase font-mono">New Room</span>
      <input type="text" name="room_name" class="flex-1 bg-transparent border-none outline-none text-base-content font-mono text-[13px]" />
      <button type="submit" class="bg-primary text-primary-content border-none rounded px-3 py-1 font-semibold cursor-pointer font-mono">Create</button>
    </form>

    {%for room <- @rooms}
      <div class="bg-base-300 border border-white/[0.15] rounded-md px-3.5 py-2.5 flex justify-between items-center mb-1.5">
        <span class="text-secondary font-mono"># {room.name}</span>
        <Hologram.UI.Link to={HolodeckWeb.Chat.RoomPage, room_name: room.name} class="bg-primary text-primary-content border-none rounded px-2.5 py-0.5 font-semibold cursor-pointer font-mono text-xs">Join</Hologram.UI.Link>
      </div>
    {/for}

  </div>
</HolodeckWeb.Components.AppShell>
