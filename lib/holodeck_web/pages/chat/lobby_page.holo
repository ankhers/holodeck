<div style="min-height: 100vh; background: #0f1014; color: #eeeeee; padding: 24px; font-family: monospace;">
  <div style="max-width: 480px; margin: 0 auto;">

    <form $submit="save_username" style="background: #13131a; border: 1px solid #363636; border-radius: 8px; padding: 12px 16px; margin-bottom: 24px; display: flex; align-items: center; gap: 10px;">
      <span style="color: #555; font-size: 11px; letter-spacing: 1px; text-transform: uppercase;">Username</span>
      <input type="text" name="username" value={@username} style="flex: 1; background: transparent; border: none; outline: none; color: #eeeeee; font-family: monospace; font-size: 13px;" />
      <button type="submit" style="background: #a78bfa; color: #0f1014; border: none; border-radius: 4px; padding: 4px 12px; font-weight: 600; cursor: pointer; font-family: monospace;">Save</button>
    </form>

    <div style="color: #555; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 10px;">Rooms</div>

    <form $submit="create_room" style="background: #13131a; border: 1px solid #363636; border-radius: 8px; padding: 12px 16px; margin-bottom: 16px; display: flex; align-items: center; gap: 10px;">
      <span style="color: #555; font-size: 11px; letter-spacing: 1px; text-transform: uppercase;">New Room</span>
      <input type="text" name="room_name" style="flex: 1; background: transparent; border: none; outline: none; color: #eeeeee; font-family: monospace; font-size: 13px;" />
      <button type="submit" style="background: #a78bfa; color: #0f1014; border: none; border-radius: 4px; padding: 4px 12px; font-weight: 600; cursor: pointer; font-family: monospace;">Create</button>
    </form>

    {%for room <- @rooms}
      <div style="background: #13131a; border: 1px solid #262626; border-radius: 6px; padding: 10px 14px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
        <span style="color: #c4b5fd;"># {room.name}</span>
        <Hologram.UI.Link to={HolodeckWeb.Chat.RoomPage, room_name: room.name} style="background: #a78bfa; color: #0f1014; border: none; border-radius: 4px; padding: 3px 10px; font-weight: 600; cursor: pointer; font-family: monospace; font-size: 12px;">Join</Hologram.UI.Link>
      </div>
    {/for}

  </div>
</div>
