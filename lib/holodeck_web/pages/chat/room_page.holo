<div class="min-h-screen bg-base-100 text-base-content flex flex-col relative overflow-x-hidden">

  <div class="hd-grain fixed inset-0 pointer-events-none z-0 opacity-[0.025]"></div>
  <div class="hd-glow fixed top-[-30%] left-1/2 -translate-x-1/2 w-[70vw] h-[50vh] pointer-events-none z-0"></div>

  <nav class="relative z-[1] flex items-center px-6 py-[18px] border-b border-white/[0.08] shrink-0">
    <div class="flex items-center gap-2.5 text-[15px] font-semibold tracking-[-0.01em]">
      <Hologram.UI.Link to={HolodeckWeb.HomePage} class="flex items-center gap-2.5 no-underline text-base-content">
        <div class="hd-logo-icon w-7 h-7 rounded-[7px] flex items-center justify-center text-sm font-bold text-white shrink-0">H</div>
        Holodeck
      </Hologram.UI.Link>
      <span class="text-base-content/50 mx-px">/</span>
      <Hologram.UI.Link to={HolodeckWeb.Chat.LobbyPage} class="text-base-content/75 font-normal no-underline">Chat</Hologram.UI.Link>
      <span class="text-base-content/50 mx-px">/</span>
      {%if @room}
        <span class="text-secondary font-normal"># {@room.name}</span>
      {/if}
    </div>
  </nav>

  {%if @room}
  <div class="relative z-[1] flex-1 overflow-y-auto p-4 flex flex-col-reverse justify-end gap-2.5 font-mono">
    {%for message <- @messages}
      <div>
        <span style={"color: " <> username_colour(message.username) <> "; font-size: 12px;"}>{message.username}</span>
        <span class="text-base-content/25 text-[11px] ml-2">{message.inserted_at}</span>
        <div class="text-base-content/75 mt-0.5">{message.message}</div>
      </div>
    {/for}
  </div>

  <form $submit="send_message" class="relative z-[1] border-t border-white/[0.15] px-4 py-3 flex gap-2 bg-base-100 shrink-0">
    <input type="text" name="message" value={@draft} $change="update_draft" placeholder="Type a message..." autocomplete="off" class="flex-1 bg-base-300 border border-white/20 rounded px-3 py-2 text-base-content font-mono text-[13px] outline-none" />
    <button type="submit" class="bg-primary text-primary-content border-none rounded px-4 py-2 font-semibold cursor-pointer font-mono">Send</button>
  </form>
  {%else}
    <div id="room-not-found" class="relative z-[1] p-6">
      <h1 class="text-xl font-semibold">Room not found</h1>
      <Hologram.UI.Link to={HolodeckWeb.Chat.LobbyPage} class="text-secondary">Back to the lobby</Hologram.UI.Link>
    </div>
  {/if}

</div>
