<HolodeckWeb.Components.AppShell breadcrumbs={@breadcrumbs} full_height={true}>

  {%if @room == nil}
    <div id="room-not-found" class="relative z-[1] p-6">
      <h1 class="text-xl font-semibold">Room not found</h1>
      <Hologram.UI.Link to={HolodeckWeb.Chat.LobbyPage} class="text-secondary">Back to the lobby</Hologram.UI.Link>
    </div>
  {%else}
    <div id="messages" role="log" aria-label="Room messages" class="relative z-[1] flex-1 min-h-0 overflow-y-auto p-4 flex flex-col-reverse gap-2.5 font-mono w-full max-w-3xl mx-auto">
      {%for message <- @messages}
        <div class="shrink-0 min-w-0">
          <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
            <span class="text-[12px] break-all" style={"color: " <> username_colour(message.username)}>{message.username}</span>
            <time class="text-base-content/40 text-[11px]">{message_time(message.inserted_at, @utc_today)}</time>
          </div>
          <div class="text-base-content/75 text-[13px] leading-relaxed mt-0.5 whitespace-pre-wrap break-words [overflow-wrap:anywhere]">{message.message}</div>
        </div>
      {/for}
    </div>

    {%if @username != ""}
      <div class="relative z-[1] border-t border-white/15 bg-base-100 shrink-0">
        <form id="message-form" $submit="send_message" class="w-full max-w-3xl mx-auto px-4 py-3 flex items-end gap-2">
          <div class="flex-1 min-w-0">
            <label for="chat-message" class="sr-only">Message</label>
            <input id="chat-message" type="text" name="message" value={@draft} $change="update_draft" placeholder="Type a message..." autocomplete="off" class="hd-input" />
          </div>
          <button id="send-message" type="submit" class="hd-btn hd-btn-primary">Send</button>
        </form>
      </div>
    {%else}
      <div id="username-required" class="relative z-[1] border-t border-white/15 px-4 py-3 bg-base-100 shrink-0 text-[13px] font-mono">
        Set a username in the <Hologram.UI.Link to={HolodeckWeb.Chat.LobbyPage} class="text-secondary">lobby</Hologram.UI.Link> to send messages.
      </div>
    {/if}
  {/if}

</HolodeckWeb.Components.AppShell>
