<HolodeckWeb.Components.AppShell breadcrumbs={[{"Dashboard", nil}]}>
  <HolodeckWeb.Components.PageHeader kicker="Server ticks · log streaming" title="Dashboard" description="Live metrics, processes and logs from the BEAM node serving this page." />

  <div id="dashboard-panels" class="grid grid-cols-1 lg:grid-cols-[355px_minmax(0,1fr)] gap-3 mb-3">

    <!-- System Metrics -->
    <div class="bg-base-200 border border-white/[0.08] rounded-[10px] p-5">
      <div class="flex items-center justify-between mb-[18px]">
        <span class="text-[11px] font-semibold uppercase tracking-[0.08em] text-base-content/50">System Metrics</span>
        <span id="metrics-status" role="status" class={"flex items-center gap-[5px] text-[11px] font-medium #{metrics_status_class(@metrics_status)}"}><div class={metrics_dot_class(@metrics_status)}></div> {@metrics_status}</span>
      </div>

      <!-- CPU -->
      <div class="mb-[18px]">
        <div class="flex items-center justify-between mb-2">
          <span class="text-[10px] font-semibold uppercase tracking-[0.07em] text-base-content/50">CPU · overall</span>
          <span class="text-[11px] text-base-content/75 font-mono">{format_percent(@system_metrics.cpu_average)}%</span>
        </div>
        <div class="h-[5px] rounded-full bg-white/[0.06] overflow-hidden mb-3"><div class={"h-full rounded-full transition-[width] duration-500 #{bar_class(@system_metrics.cpu_average)}"} style={"width: #{format_percent(@system_metrics.cpu_average)}%;"}></div></div>
        <div id="cpu-cores" aria-label="Per-core CPU usage" class="grid grid-cols-8 gap-2 max-h-[132px] overflow-y-auto pr-1">
          {%for {core, percent_used, _, _} <- @system_metrics.cpu}
            <div title={"Core #{core}: #{format_percent(percent_used)}%"}>
              <div class="text-[9px] text-base-content/50 font-mono mb-1">C{core}</div>
              <div class="h-1 rounded-full bg-white/[0.06] overflow-hidden"><div class={"h-full transition-[width] duration-500 #{bar_class(percent_used)}"} style={"width: #{format_percent(percent_used)}%;"}></div></div>
            </div>
          {/for}
        </div>
      </div>

      <!-- Memory -->
      <div class="mb-[18px]">
        <div class="text-[10px] font-semibold uppercase tracking-[0.07em] text-base-content/50 mb-2.5">Memory</div>
        <div class="flex justify-between mb-[5px]">
          <span class="text-[11px] text-base-content/75">Total</span>
          <span class="text-[11px] text-base-content/75 font-mono">{format_bytes(@system_metrics.memory.total)}</span>
        </div>
        <div class="grid grid-cols-2 gap-[7px]">
          <div class="bg-white/[0.03] border border-white/[0.08] rounded-[7px] px-[11px] py-[9px]">
            <div class="text-[10px] text-base-content/50 uppercase tracking-[0.05em] mb-0.5">Atom</div>
            <div class="text-sm font-semibold text-base-content font-mono">{format_bytes(@system_metrics.memory.atom)}</div>
          </div>
          <div class="bg-white/[0.03] border border-white/[0.08] rounded-[7px] px-[11px] py-[9px]">
            <div class="text-[10px] text-base-content/50 uppercase tracking-[0.05em] mb-0.5">Binary</div>
            <div class="text-sm font-semibold text-base-content font-mono">{format_bytes(@system_metrics.memory.binary)}</div>
          </div>
          <div class="bg-white/[0.03] border border-white/[0.08] rounded-[7px] px-[11px] py-[9px]">
            <div class="text-[10px] text-base-content/50 uppercase tracking-[0.05em] mb-0.5">Code</div>
            <div class="text-sm font-semibold text-base-content font-mono">{format_bytes(@system_metrics.memory.code)}</div>
          </div>
          <div class="bg-white/[0.03] border border-white/[0.08] rounded-[7px] px-[11px] py-[9px]">
            <div class="text-[10px] text-base-content/50 uppercase tracking-[0.05em] mb-0.5">ETS</div>
            <div class="text-sm font-semibold text-base-content font-mono">{format_bytes(@system_metrics.memory.ets)}</div>
          </div>
        </div>
      </div>

      <hr class="border-0 border-t border-white/[0.08] my-4" />

      <div class="grid grid-cols-2 gap-[7px]">
        <div class="bg-white/[0.03] border border-white/[0.08] rounded-[7px] px-[11px] py-[9px]">
          <div class="text-[10px] text-base-content/50 uppercase tracking-[0.05em] mb-0.5">Uptime</div>
          <div class="text-sm font-semibold text-base-content font-mono">{format_uptime(@system_metrics.uptime)}</div>
        </div>
        <div class="bg-white/[0.03] border border-white/[0.08] rounded-[7px] px-[11px] py-[9px]">
          <div class="text-[10px] text-base-content/50 uppercase tracking-[0.05em] mb-0.5">Elixir / OTP</div>
          <div class="text-sm font-semibold text-base-content font-mono">{@system_metrics.elixir} / {@system_metrics.otp}</div>
        </div>
        <div class="bg-white/[0.03] border border-white/[0.08] rounded-[7px] px-[11px] py-[9px]">
          <div class="text-[10px] text-base-content/50 uppercase tracking-[0.05em] mb-0.5">Schedulers</div>
          <div class="text-sm font-semibold text-base-content font-mono">{@system_metrics.schedulers.online} / {@system_metrics.schedulers.total}</div>
        </div>
        <div class="bg-white/[0.03] border border-white/[0.08] rounded-[7px] px-[11px] py-[9px]">
          <div class="text-[10px] text-base-content/50 uppercase tracking-[0.05em] mb-0.5">Processes</div>
          <div class="text-sm font-semibold text-base-content font-mono">{format_integer(@system_metrics.process_count)}</div>
        </div>
      </div>
    </div>

    <!-- Process List -->
    <div id="process-panel" class="min-w-0 bg-base-200 border border-white/[0.08] rounded-[10px] p-5">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-[18px]">
        <div class="flex items-center gap-2.5">
          <span class="text-[11px] font-semibold uppercase tracking-[0.08em] text-base-content/50">Processes</span>
          <span class="text-[11px] text-base-content/50">{format_integer(@system_metrics.process_count)} total</span>
        </div>
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-[5px]">
            <span class="text-[10px] text-base-content/50">sort</span>
            <button type="button" class={sort_button_class(@process_sort, :memory)} id="sort-memory" $click={:sort, by: :memory}>memory</button>
            <button type="button" class={sort_button_class(@process_sort, :reductions)} id="sort-reductions" $click={:sort, by: :reductions}>reductions</button>
            <button type="button" class={sort_button_class(@process_sort, :pid)} id="sort-pid" $click={:sort, by: :pid}>pid</button>
          </div>
          <span id="process-status" class={"flex items-center gap-[5px] text-[11px] font-medium #{metrics_status_class(@metrics_status)}"}><div class={metrics_dot_class(@metrics_status)}></div> {@metrics_status}</span>
        </div>
      </div>

      <div id="process-table-scroll" class="max-h-[520px] overflow-auto">
      <table id="process-table" class="w-full min-w-[560px] border-collapse">
        <thead>
          <tr>
            <th class="text-[10px] font-semibold uppercase tracking-[0.07em] text-base-content/50 text-left px-2.5 pb-2.5 border-b border-white/[0.08]">PID</th>
            <th class="text-[10px] font-semibold uppercase tracking-[0.07em] text-base-content/50 text-left px-2.5 pb-2.5 border-b border-white/[0.08]">Name</th>
            <th class="text-[10px] font-semibold uppercase tracking-[0.07em] text-base-content/50 text-left px-2.5 pb-2.5 border-b border-white/[0.08]">Memory</th>
            <th class="text-[10px] font-semibold uppercase tracking-[0.07em] text-base-content/50 text-left px-2.5 pb-2.5 border-b border-white/[0.08]">Reductions</th>
            <th class="text-[10px] font-semibold uppercase tracking-[0.07em] text-base-content/50 text-left px-2.5 pb-2.5 border-b border-white/[0.08]">Status</th>
          </tr>
        </thead>
        <tbody>
          {%for {p, p_info} <- @system_metrics.processes}
            <tr class="hd-proc-row">
              <td class="px-2.5 py-[9px] border-b border-white/[0.04] font-mono text-[11px] text-primary">{inspect(p)}</td>
              <td class="px-2.5 py-[9px] border-b border-white/[0.04] text-[13px] text-base-content/75 max-w-[240px] break-words">
                {%if p_info[:registered_name] != []}
                  {p_info[:registered_name]}
                {%else}
                  <span class="text-[11px] text-base-content/50 font-mono">{p_info[:initial_call]}</span>
                {/if}
              </td>
              <td class="px-2.5 py-[9px] border-b border-white/[0.04]">
                <span class="font-mono text-xs text-base-content/75">{format_bytes(p_info[:memory])}</span>
              </td>
              <td class="px-2.5 py-[9px] border-b border-white/[0.04] font-mono text-[11px] text-base-content/50">{format_integer(p_info[:reductions])}</td>
              <td class="px-2.5 py-[9px] border-b border-white/[0.04]"><span class="text-[10px] font-semibold px-[7px] py-0.5 rounded bg-primary/[0.12] text-primary">{p_info[:status]}</span></td>
            </tr>
          {/for}
        </tbody>
      </table>
      </div>
      <div class="text-center pt-3 text-[11px] text-base-content/50">Showing top {length(@system_metrics.processes)} of {format_integer(@system_metrics.process_count)} processes</div>
    </div>
  </div>

  <!-- Log Stream -->
  <div class="bg-base-200 border border-white/[0.08] rounded-[10px] p-5">
    <div class="flex items-center justify-between mb-[18px]">
      <span class="text-[11px] font-semibold uppercase tracking-[0.08em] text-base-content/50">Log Stream</span>
      <span class="text-[11px] text-base-content/50 font-medium">streaming</span>
    </div>

    {%if @log_msgs == []}
      <div id="log-empty" class="py-6 text-center text-xs text-base-content/50 font-mono">Waiting for log events…</div>
    {%else}
    <div id="log-stream" class="font-mono text-xs">
      <div class="hd-log-row text-[10px] uppercase tracking-wider text-base-content/50" aria-hidden="true"><span>Level</span><span>Time · UTC</span><span>Module</span><span>Message</span></div>
      {%for log <- @log_msgs}
        <div class="hd-log-row border-b border-white/[0.04] rounded">
          <span class={"text-[10px] font-bold px-1 py-px rounded-[3px] text-center #{log_level_class(log)}"}>{log_level(log)}</span>
          <span class="text-base-content/50" title="UTC">{format_time(log.time)}</span>
          <span class="text-primary min-w-0 [overflow-wrap:anywhere]">[{log.module}]</span>
          <span class="text-base-content/75 min-w-0 whitespace-pre-wrap [overflow-wrap:anywhere]">{log.msg}</span>
        </div>
      {/for}
    </div>
    {/if}
  </div>

</HolodeckWeb.Components.AppShell>
